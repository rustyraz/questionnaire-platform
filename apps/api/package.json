{
    "name": "api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/main.js",
        "migration:run": "tsx src/database/migrate.ts",
        "migration:revert": "tsx src/database/migrate.ts --revert",
        "seed": "tsx scripts/seed.ts"
    },
    "dependencies": {
        "typeorm": "^0.3.20",
        "pg": "^8.13.0",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0"
    }
}